# ================= DeepSeek（必填）=================
# 到 https://platform.deepseek.com 创建 API Key 后填到这里（复制本文件为 .env 再填）
DEEPSEEK_API_KEY=

# 官方接口地址，一般不用改
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型：deepseek-v4-flash（推理模型，先思考再回答）；想要更强改 deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-v4-flash

# ================= 机器人连接（对应 NapCat 里的反向 WebSocket 地址）=================
# 下面三项拼起来就是 NapCat 要填的地址：
#   ws://127.0.0.1:3001/onebot/v11/ws
BOT_WS_HOST=127.0.0.1
BOT_WS_PORT=3001
BOT_WS_PATH=/onebot/v11/ws

# 测试模式：1 = 不调用 DeepSeek，直接回显收到的话（先验证链路，不花钱）
BOT_DRY_RUN=0

# ================= 人设与行为 ==================
# 在这里写机器人的人设/提示词，留空则用代码里的默认值
BOT_SYSTEM_PROMPT=

# 每个会话保留的最近消息条数（越大上下文越长、越耗 token）
BOT_MAX_HISTORY=12

# 单条回复最大字符数（QQ 单条消息有长度上限，超长会自动分段发送）
BOT_REPLY_MAX_CHARS=1800

# 触发方式：at_or_prefix = 群里@机器人或消息以 / 开头；all = 群里每条都回；prefix = 仅 / 开头
BOT_TRIGGER_MODE=at_or_prefix

# 触发前缀（触发方式含 prefix 时生效）
BOT_PREFIX=/

# 是否响应私聊 / 群聊
BOT_ENABLE_PRIVATE=1
BOT_ENABLE_GROUPS=1
